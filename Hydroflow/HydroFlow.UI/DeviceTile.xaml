<!--
    File: DeviceTile.xaml
    Author: Jacob Fonseca
    Project: HydroFlow SCADA
    Task: HF-97

    One device tile. Its colour follows the device's alert status: green Normal, amber Warning, red Alarm.
    The DataContext is a DashboardRow.
-->
<UserControl x:Class="HydroFlow.UI.DeviceTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Margin="0,0,8,8">
    <Border CornerRadius="4" Padding="8,6" BorderThickness="2">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#E8F5E9" />
                <Setter Property="BorderBrush" Value="#2E7D32" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AlertStatus}" Value="Warning">
                        <Setter Property="Background" Value="#FFF8E1" />
                        <Setter Property="BorderBrush" Value="#F9A825" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AlertStatus}" Value="Alarm">
                        <Setter Property="Background" Value="#FFEBEE" />
                        <Setter Property="BorderBrush" Value="#C62828" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DeviceId}" Foreground="Gray" FontSize="11" />
            <!-- The latest reading stays on the tile when an Alarm packet changes the colour. -->
            <TextBlock FontSize="16" Margin="0,2,0,0">
                <Run Text="{Binding Value, Mode=OneWay, StringFormat={}{0:0.##}, TargetNullValue=Waiting}" />
                <Run Text="{Binding Unit, Mode=OneWay}" />
            </TextBlock>
            <!-- Status is also written out, so the tile doesn't rely on colour alone. -->
            <TextBlock Text="{Binding AlertStatus}" FontSize="11" />
        </StackPanel>
    </Border>
</UserControl>
