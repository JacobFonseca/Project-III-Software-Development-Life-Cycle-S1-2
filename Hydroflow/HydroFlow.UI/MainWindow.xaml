<!--
    File: MainWindow.xaml
    Author: Jacob Fonseca
    Project: HydroFlow SCADA
    Task: HF-38

    Lists the latest reading from each HydroFlow device by module and hosts the team's dashboard controls.
-->
<Window x:Class="HydroFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HydroFlow.UI"
        mc:Ignorable="d"
        Title="HydroFlow SCADA" Height="800" Width="1100">
    <Window.Resources>
        <!-- HF-97: each device row is drawn as a DeviceTile in the tiles slot. -->
        <DataTemplate x:Key="DeviceTileTemplate">
            <local:DeviceTile />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="DeviceTilePanel">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <!-- HF-63: opens the logger diagnostics view in its own window. -->
            <Button x:Name="DiagnosticsButton" DockPanel.Dock="Right" Content="Logger diagnostics"
                    Padding="10,2" VerticalAlignment="Center" Click="DiagnosticsButton_Click" />

            <TextBlock Text="Latest device readings" FontSize="18" FontWeight="SemiBold" />

            <!-- HF-97: system health, "All normal" or "N alerts". -->
            <TextBlock x:Name="HealthText" Text="{Binding HealthText}" FontSize="18" Margin="16,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#2E7D32" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveAlerts}" Value="True">
                                <Setter Property="Foreground" Value="#C62828" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- HF-57: empty slots for the team's UserControls. Each owner's control is placed here from code. -->
        <!-- Alarm banner (Afsana, HF-67). -->
        <ContentControl x:Name="AlarmBannerSlot" Grid.Row="1" />

        <!-- Device tiles (Jacob, HF-97). -->
        <ContentControl x:Name="DeviceTilesSlot" Grid.Row="2" Margin="0,0,0,8" />

        <!-- Control panel (Kadeema, HF-64). -->
        <ContentControl x:Name="ControlPanelSlot" Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Margin="12,0,0,0" />

        <!-- Read-only: one row per device ID, grouped by module (HF-59), refreshed when that device publishes. -->
        <DataGrid x:Name="ReadingsGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,8,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="*" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat={}{0:0.##}}" Width="*" />
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
                <!-- HF-97: the device's current status from the controller, same as its tile. -->
                <DataGridTextColumn Header="Status" Binding="{Binding AlertStatus}" Width="*" />
                <DataGridTextColumn Header="Last updated" Binding="{Binding LastUpdatedLocal, StringFormat={}{0:h:mm:ss tt}, TargetNullValue=Waiting}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="EmptyMessage" Grid.Row="4" Margin="0,8,0,0"
                   Text="Waiting for device readings." Foreground="Gray" />
    </Grid>
</Window>
