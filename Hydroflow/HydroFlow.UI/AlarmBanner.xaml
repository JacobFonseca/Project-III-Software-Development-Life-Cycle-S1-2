<UserControl x:Class="HydroFlow.UI.AlarmBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="AlarmList">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{Binding Background}" CornerRadius="4"
                        Padding="10,6" Margin="0,0,0,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Acknowledge" Padding="12,2"
                                Tag="{Binding DeviceId}" Click="Acknowledge_Click"/>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
